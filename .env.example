# Copy to .env and fill in. Find these in Supabase: Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public key. Safe to send to the browser.
SUPABASE_ANON_KEY=your-anon-public-key
# Secret key. Server only. Never commit it or expose it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

SECRET_KEY=generate-a-long-random-string
# Comma-separated list of allowed origins, or * for any (fine when Flask serves the frontend).
CORS_ORIGINS=*
FLASK_DEBUG=0
PORT=5000
